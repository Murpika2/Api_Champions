+# Integración continua: en cada push o pull request ejecuta las pruebas
+# y comprueba que la imagen de Docker se construye y responde.
+name: CI
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  pruebas:
+    runs-on: ubuntu-latest
+    strategy:
+      matrix:
+        python-version: ["3.11", "3.13"]
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-python@v5
+        with:
+          python-version: ${{ matrix.python-version }}
+      - name: Instalar dependencias
+        run: pip install -r requirements-dev.txt
+      - name: Pruebas P01–P16
+        run: python -m pytest -v
+
+  docker:
+    runs-on: ubuntu-latest
+    needs: pruebas
+    steps:
+      - uses: actions/checkout@v4
+      - name: Construir imagen
+        run: docker build -t api-champions:ci .
+      - name: Levantar contenedor y verificar /api/health
+        run: |
+          docker run -d --name api -p 8000:8000 \
+            -e JWT_SECRET_KEY="$(python3 -c 'import secrets;print(secrets.token_hex(32))')" \
+            -e ADMIN_PASSWORD="ci-$(python3 -c 'import secrets;print(secrets.token_hex(8))')" \
+            api-champions:ci
+          for i in $(seq 1 30); do
+            curl -fsS http://localhost:8000/api/health && exit 0
+            sleep 1
+          done
+          docker logs api
+          exit 1
