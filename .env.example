# Copia este archivo como .env y cambia los valores. NUNCA subas el .env al repositorio.

# Clave para firmar los JWT (mínimo 32 caracteres, aleatoria).
# Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia-esto-por-una-clave-aleatoria-de-64-caracteres
# Minutos de validez del token
JWT_EXPIRES_MINUTES=60

# Ruta del archivo SQLite. En la nube debe estar en un disco/volumen persistente.
DATABASE_PATH=data/champions.db

# Usuarios iniciales: solo se crean la primera vez (cuando no hay usuarios en la base).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-contrasena
# Usuario de solo lectura (opcional, sirve para probar permisos)
VIEWER_USERNAME=invitado
VIEWER_PASSWORD=cambia-esta-otra

# Carga equipos y goleadores de ejemplo si la base está vacía
SEED_DEMO_DATA=true

# Cupos de clasificación (0 = automático, la mitad de los equipos)
QUALIFICATION_SPOTS=0

# Dirección de la API que usa la interfaz web (/api si van en el mismo servidor)
FRONTEND_API_BASE=/api

# Orígenes autorizados para CORS, separados por coma (vacío = solo mismo origen)
# Ejemplo: CORS_ORIGINS=https://mi-frontend.netlify.app,http://localhost:5173
CORS_ORIGINS=

# Desarrollo local
FLASK_DEBUG=0
PORT=5000
